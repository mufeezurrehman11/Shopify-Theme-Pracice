<script>
  document.addEventListener("DOMContentLoaded", function () {
    const allDetails = document.querySelectorAll(".HA-accordion-details-tag");

    allDetails.forEach((details) => {
      const summary = details.querySelector("summary");
      const content = details.querySelector(".accordion__content");

      // 🔥 FIX: If already open on page load, set height
      if (details.hasAttribute("open")) {
        details.classList.add("HA-open");
        content.style.height = content.scrollHeight + "px";

        // Optional: reset to auto after initial load
        setTimeout(() => {
          content.style.height = "auto";
        }, 300);
      }

      summary.addEventListener("click", function (e) {
        e.preventDefault();

        const isOpen = details.hasAttribute("open");

        allDetails.forEach((other) => {
          if (other !== details) {
            other.removeAttribute("open");
            other.classList.remove("HA-open");
            const otherContent = other.querySelector(".accordion__content");
            otherContent.style.height = 0;
          }
        });

        if (!isOpen) {
          details.setAttribute("open", true);
          details.classList.add("HA-open");

          content.style.height = content.scrollHeight + "px";
          setTimeout(() => {
            content.style.height = "auto";
          }, 300);
        } else {
          content.style.height = content.scrollHeight + "px";
          requestAnimationFrame(() => {
            content.style.height = "0px";
          });

          details.removeAttribute("open");
          details.classList.remove("HA-open");
        }
      });
    });
  });
</script>



























{% schema %}
{
